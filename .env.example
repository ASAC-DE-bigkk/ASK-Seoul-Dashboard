# Runtime
AUTH_ENV=development
AUTH_MODE=required
DATABASE_URL=sqlite:///./data/ask_seoul.db
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8765
AUTH_ALLOWED_HOSTS=127.0.0.1,localhost
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY_HEADERS=false
AUTH_BIND_SESSION_USER_AGENT=true
AUTH_BIND_SESSION_IP=false
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=false
AUTH_MFA_MASTER_KEY=
AUTH_AUTO_APPROVE_VERIFIED=true
AUTH_SESSION_HOURS=12
AUTH_SESSION_IDLE_MINUTES=120
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_REMEMBER_DAYS=30
AUTH_REMEMBER_IDLE_DAYS=7
AUTH_RESET_TOKEN_MINUTES=30
AUTH_VERIFY_TOKEN_HOURS=24
AUTH_MAX_REQUEST_BYTES=262144

# Charts Studio
CHARTS_TRINO_URL=http://127.0.0.1:30586
CHARTS_TRINO_USER=charts-studio
CHARTS_CACHE_TTL=600
CHARTS_MAX_CONCURRENT_QUERIES=4

# Production에서는 아래 값을 반드시 별도 secret manager에서 주입한다.
# 비우면 development 환경에서만 data/.auth_session_secret을 자동 생성한다.
AUTH_SESSION_PEPPER=

# development/test의 일회성 자동 검증 전용. production은 사용을 거부하며,
# 최고관리자는 보호된 TTY에서 scripts/create_admin.py로 생성한다.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# SMTP email verification / password reset (선택)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# production에서 내부 보안 relay가 평문 SMTP만 제공할 때만 명시적으로 true
SMTP_ALLOW_PLAINTEXT=false

# 운영 알림 채널 (선택)
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_IDS=
