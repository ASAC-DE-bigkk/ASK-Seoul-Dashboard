{
 "version": 1,
 "pages": [
  {
   "id": "seed-overview",
   "name": "상권 개요",
   "charts": [
    {
     "id": "ov-stat-open",
     "title": "영업 중 업소",
     "type": "stat",
     "source": "gold_license_dong_summary",
     "bindings": {"value": "business_open_count"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 0, "w": 3, "h": 2}
    },
    {
     "id": "ov-stat-new",
     "title": "최근 1년 개업",
     "type": "stat",
     "source": "gold_license_dong_category_matrix",
     "bindings": {"value": "opened_last_365d"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 3, "y": 0, "w": 3, "h": 2}
    },
    {
     "id": "ov-pie-major",
     "title": "대분류별 영업 업소 구성",
     "type": "pie",
     "source": "gold_license_dong_category_matrix",
     "bindings": {"axis": "major", "value": "active_cnt"},
     "agg": "sum",
     "filters": [],
     "options": {"donut": true},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "ov-map-gu",
     "title": "자치구별 영업 업소",
     "type": "map_seoul",
     "source": "gold_license_dong_summary",
     "bindings": {"region": "gu", "value": "business_open_count"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 2, "w": 6, "h": 5}
    },
    {
     "id": "ov-line-flow",
     "title": "월별 개업·폐업 추이 (2016~)",
     "type": "line",
     "source": "gold_license_flow_monthly",
     "bindings": {"axis": "ym", "value": "cnt", "series": "event_type"},
     "agg": "sum",
     "filters": [{"field": "ym", "op": "gte", "value": "2016-01"}],
     "options": {"smooth": false},
     "grid": {"x": 6, "y": 4, "w": 6, "h": 5}
    },
    {
     "id": "ov-bar-gu-new",
     "title": "자치구별 최근 1년 개업 TOP 15",
     "type": "bar",
     "source": "gold_license_dong_category_matrix",
     "bindings": {"axis": "gu", "value": "opened_last_365d"},
     "agg": "sum",
     "filters": [],
     "options": {"top_n": 15},
     "grid": {"x": 0, "y": 7, "w": 6, "h": 4}
    }
   ]
  },
  {
   "id": "seed-dynamics",
   "name": "업종 동학",
   "charts": [
    {
     "id": "dy-heat-season",
     "title": "개업 계절성 — 월 × 중분류",
     "type": "heatmap",
     "source": "gold_license_seasonality",
     "bindings": {"x": "month_of_year", "y": "category", "value": "cnt"},
     "agg": "sum",
     "filters": [{"field": "event_type", "op": "eq", "value": "opened"}],
     "options": {"top_n": 14},
     "grid": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "dy-line-cohort",
     "title": "외식업 창업 코호트 생존율 (2017~2022)",
     "type": "line",
     "source": "gold_license_cohort_survival",
     "bindings": {"axis": "years_elapsed", "value": "survival_rate", "series": "cohort_y"},
     "agg": "avg",
     "filters": [
      {"field": "category", "op": "eq", "value": "food"},
      {"field": "cohort_y", "op": "in", "value": ["2017", "2018", "2019", "2020", "2021", "2022"]}
     ],
     "options": {"smooth": true},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "dy-bar-early",
     "title": "중분류별 조기폐업률 (n≥100 · 구·업종 단순평균)",
     "type": "bar",
     "source": "gold_license_lifespan",
     "bindings": {"axis": "category", "value": "early_close_ratio"},
     "agg": "avg",
     "filters": [{"field": "n_closed", "op": "gte", "value": 100}],
     "options": {"top_n": 14},
     "grid": {"x": 0, "y": 4, "w": 6, "h": 4}
    },
    {
     "id": "dy-bar-age",
     "title": "업력 밴드 × 대분류 (신상 vs 노포)",
     "type": "bar",
     "source": "gold_license_stock_age_band",
     "bindings": {"axis": "age_band", "value": "active_cnt", "series": "major"},
     "agg": "sum",
     "filters": [],
     "options": {"stacked": true},
     "grid": {"x": 6, "y": 4, "w": 6, "h": 4}
    }
   ]
  },
  {
   "id": "seed-race",
   "name": "타임랩스",
   "charts": [
    {
     "id": "ra-cat-open",
     "title": "업종별 누적 개업 경주 (2016~)",
     "type": "race",
     "source": "gold_license_flow_monthly",
     "bindings": {"time": "ym", "axis": "category", "value": "cnt"},
     "agg": "sum",
     "filters": [
      {"field": "event_type", "op": "eq", "value": "opened"},
      {"field": "ym", "op": "gte", "value": "2016-01"}
     ],
     "options": {"cumulative": true, "top_n": 12, "interval_ms": 600},
     "grid": {"x": 0, "y": 0, "w": 12, "h": 6}
    }
   ]
  },
  {
   "id": "seed-citydata-live",
   "name": "도시 실시간 (citydata)",
   "charts": [
    {
     "id": "cd-stat-ppltn",
     "title": "핫플 추정 인구 합 (현재)",
     "type": "stat",
     "source": "gold_citydata_place_latest",
     "bindings": {"value": "area_ppltn_max"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 0, "w": 3, "h": 2}
    },
    {
     "id": "cd-stat-pm25",
     "title": "평균 초미세먼지 (㎍/㎥)",
     "type": "stat",
     "source": "gold_citydata_place_latest",
     "bindings": {"value": "pm25"},
     "agg": "avg",
     "filters": [],
     "options": {},
     "grid": {"x": 3, "y": 0, "w": 3, "h": 2}
    },
    {
     "id": "cd-pie-congest",
     "title": "혼잡도 수준별 인구 구성 (현재)",
     "type": "pie",
     "source": "gold_citydata_place_latest",
     "bindings": {"axis": "area_congest_lvl", "value": "area_ppltn_max"},
     "agg": "sum",
     "filters": [],
     "options": {"donut": true},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "cd-map-gu",
     "title": "자치구별 현재 추정 인구",
     "type": "map_seoul",
     "source": "gold_citydata_place_latest",
     "bindings": {"region": "gu", "value": "area_ppltn_max"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 2, "w": 6, "h": 5}
    },
    {
     "id": "cd-bar-hot",
     "title": "뜨는 상권 TOP 15 (hot_index)",
     "type": "bar",
     "source": "gold_citydata_hot_commerce",
     "bindings": {"axis": "area_nm", "value": "hot_index"},
     "agg": "avg",
     "filters": [],
     "options": {"top_n": 15},
     "grid": {"x": 6, "y": 4, "w": 6, "h": 5}
    },
    {
     "id": "cd-bar-anomaly",
     "title": "평소 대비 급증 TOP 15 (%)",
     "type": "bar",
     "source": "gold_citydata_ppltn_anomaly",
     "bindings": {"axis": "area_nm", "value": "pct_vs_normal"},
     "agg": "avg",
     "filters": [],
     "options": {"top_n": 15},
     "grid": {"x": 0, "y": 7, "w": 6, "h": 4}
    },
    {
     "id": "cd-points",
     "title": "핫플 좌표 · 인구 밀도",
     "type": "map_points",
     "source": "gold_citydata_place_latest",
     "bindings": {"lat": "latitude", "lng": "longitude", "value": "area_ppltn_max"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 6, "y": 9, "w": 6, "h": 5}
    }
   ]
  },
  {
   "id": "seed-citydata-history",
   "name": "인구 이력·구매력 (citydata)",
   "charts": [
    {
     "id": "cd-line-daily",
     "title": "일별 평균 붐빔 추이 (장소 평균)",
     "type": "line",
     "source": "gold_citydata_ppltn_daily",
     "bindings": {"axis": "event_date", "value": "average_population"},
     "agg": "avg",
     "filters": [],
     "options": {"smooth": true},
     "grid": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "cd-line-forecast",
     "title": "시간대별 기대 붐빔 — 주말 vs 평일",
     "type": "line",
     "source": "gold_citydata_ppltn_forecast",
     "bindings": {"axis": "hr", "value": "expected_ppltn", "series": "is_weekend"},
     "agg": "avg",
     "filters": [],
     "options": {"smooth": true},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "cd-bar-spend",
     "title": "구매력 지수 TOP 15 (spend_per_crowd)",
     "type": "bar",
     "source": "gold_citydata_purchasing_power_daily",
     "bindings": {"axis": "area_nm", "value": "spend_per_crowd_idx"},
     "agg": "avg",
     "filters": [],
     "options": {"top_n": 15},
     "grid": {"x": 0, "y": 4, "w": 6, "h": 4}
    },
    {
     "id": "cd-map-dong-comm",
     "title": "행정동별 영업 상가 밀도",
     "type": "map_seoul_dong",
     "source": "gold_citydata_ppltn_x_commerce_dong",
     "bindings": {"region": "admin_dong", "value": "license_active"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 6, "y": 4, "w": 6, "h": 5}
    },
    {
     "id": "cd-table-score",
     "title": "장소 스코어카드 TOP 30",
     "type": "table",
     "source": "gold_citydata_place_scorecard",
     "bindings": {"axis": "area_nm", "value": "area_ppltn_max"},
     "agg": "sum",
     "filters": [],
     "options": {"top_n": 30},
     "grid": {"x": 0, "y": 8, "w": 6, "h": 4}
    }
   ]
  },
  {
   "id": "seed-geo",
   "name": "지역 심층",
   "charts": [
    {
     "id": "ge-points",
     "title": "상권 밀집 격자 (500m)",
     "type": "map_points",
     "source": "gold_license_geo_grid",
     "bindings": {"lat": "grid_lat", "lng": "grid_lng", "value": "active_cnt"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 0, "w": 6, "h": 5}
    },
    {
     "id": "ge-map-dong",
     "title": "행정동별 영업 업소",
     "type": "map_seoul_dong",
     "source": "gold_license_dong_summary",
     "bindings": {"region": "admin_dong", "value": "business_open_count"},
     "agg": "sum",
     "filters": [],
     "options": {},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 5}
    },
    {
     "id": "ge-map-legal",
     "title": "법정동별 개업 (2025~)",
     "type": "map_seoul_legal",
     "source": "gold_license_flow_monthly",
     "bindings": {"region": "legal_code", "value": "cnt"},
     "agg": "sum",
     "filters": [
      {"field": "event_type", "op": "eq", "value": "opened"},
      {"field": "ym", "op": "gte", "value": "2025-01"}
     ],
     "options": {},
     "grid": {"x": 0, "y": 5, "w": 6, "h": 5}
    },
    {
     "id": "ge-table-dong",
     "title": "행정동 상권 요약 TOP 50",
     "type": "table",
     "source": "gold_license_dong_summary",
     "bindings": {"axis": "admin_dong", "value": "business_open_count"},
     "agg": "sum",
     "filters": [],
     "options": {"top_n": 50},
     "grid": {"x": 6, "y": 5, "w": 6, "h": 5}
    }
   ]
  },
  {
   "id": "seed-domains",
   "name": "도메인 골드",
   "charts": [
    {
     "id": "dm-culture-line",
     "title": "일자별 문화 활동",
     "type": "line",
     "source": "gold_culture_activity_by_dong",
     "bindings": {"axis": "event_date", "value": "activities_count"},
     "agg": "sum",
     "filters": [],
     "options": {"smooth": false},
     "grid": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "dm-traffic-line",
     "title": "행정동별 교통 돌발 건수",
     "type": "bar",
     "source": "gold_traffic_incident_current_by_admin_dong_hourly",
     "bindings": {"axis": "admin_dong", "value": "incident_count"},
     "agg": "sum",
     "filters": [],
     "options": {"top_n": 20},
     "grid": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
     "id": "dm-weather-map",
     "title": "자치구 평균 기온",
     "type": "map_seoul",
     "source": "gold_weather_current_wide_by_gu",
     "bindings": {"region": "gu", "value": "temp_avg_c"},
     "agg": "avg",
     "filters": [],
     "options": {},
     "grid": {"x": 0, "y": 4, "w": 6, "h": 5}
    },
    {
     "id": "dm-citydata-scatter",
     "title": "장소별 인구와 결제 건수",
     "type": "scatter",
     "source": "gold_citydata_place_latest",
     "bindings": {"axis": "area_nm", "x": "area_ppltn_max", "y": "payment_count"},
     "agg": "avg",
     "filters": [],
     "options": {"top_n": 100},
     "grid": {"x": 6, "y": 4, "w": 6, "h": 5}
    },
    {
     "id": "dm-transit-table",
     "title": "행정동 코드별 지하철 도착 정보 수",
     "type": "table",
     "source": "gold_transit_dong_hourly",
     "bindings": {"axis": "admin_dong_code", "value": "subway_arrival_cnt"},
     "agg": "sum",
     "filters": [],
     "options": {"top_n": 50},
     "grid": {"x": 0, "y": 9, "w": 12, "h": 5}
    }
   ]
  }
 ]
}
