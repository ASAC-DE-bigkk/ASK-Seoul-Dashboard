# Public ingress overlay values for deploy/compose.public.yaml.
# Use the same runtime env file as the base dashboard stack, then add this file as a second --env-file.

PUBLIC_HOST=dashboard.example.com
AUTH_PUBLIC_BASE_URL=https://dashboard.example.com
AUTH_ALLOWED_HOSTS=dashboard.example.com,127.0.0.1,localhost
AUTH_COOKIE_SECURE=true
AUTH_TRUST_PROXY_HEADERS=true
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=true
AUTH_AUTO_APPROVE_VERIFIED=false

HTTP_PORT=80
HTTPS_PORT=443
