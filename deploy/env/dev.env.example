# 개발 환경(deploy/compose.dev.yaml) 값. .env 로 복사해 채운다. 실제 값은 커밋 금지.
# 사용:  docker compose -f deploy/compose.dev.yaml --env-file deploy/env/dev.env up --build

# PostgreSQL (앱 인증 DB)
POSTGRES_USER=askseoul
POSTGRES_PASSWORD=change-me-dev-postgres-password
POSTGRES_DB=askseoul

# 세션/보안 — 비우면 development에서 자동 생성/파생되지만, 재기동 간 일관성을 위해 지정 권장.
# 32자 이상: 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SESSION_PEPPER=
AUTH_MFA_MASTER_KEY=

# 최초 로그인용 관리자(둘 다 설정 또는 둘 다 비움). 비밀번호는 15자 이상.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin-password

# 앱 publish 포트(호스트, 127.0.0.1 전용)
DASHBOARD_PORT=8765

# 별도 배포된 Trino companion. deploy/trino/compose.yaml 이 만드는 elt_net 의 DNS alias.
# CHARTS_TRINO_URL=http://trino:8080
# DASHBOARD_DATA_NETWORK=elt_net
