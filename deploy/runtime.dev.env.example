# 현재 dev 서버용 템플릿
# - dashboard는 서버 loopback에만 bind한다.
# - 접속은 SSH local port forwarding을 사용한다.
# - 인증/권한/레이아웃 DB는 전용 PostgreSQL과 named volume을 사용한다.
# - Charts Studio 데이터 조회는 기존 Trino를 계속 사용한다.
# - 실제 비밀번호와 auth secret은 bootstrap-dev.sh가 서버에서 생성한다.

DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_MEMORY_LIMIT=1g
DASHBOARD_CPUS=1.0
DASHBOARD_PIDS_LIMIT=256
UVICORN_WORKERS=1
HEALTHCHECK_HOST=127.0.0.1

AUTH_ENV=development
AUTH_MODE=required
POSTGRES_USER=ask_seoul
POSTGRES_PASSWORD=replace-with-server-generated-hex-secret
POSTGRES_DB=ask_seoul
DATABASE_URL=postgresql+psycopg://ask_seoul:replace-with-server-generated-hex-secret@postgres:5432/ask_seoul
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8765
AUTH_ALLOWED_HOSTS=127.0.0.1,localhost
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY_HEADERS=false
AUTH_BIND_SESSION_USER_AGENT=true
AUTH_BIND_SESSION_IP=false
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=false
AUTH_SESSION_PEPPER=replace-with-server-generated-hex-secret
AUTH_MFA_MASTER_KEY=replace-with-another-server-generated-hex-secret
AUTH_AUTO_APPROVE_VERIFIED=true
AUTH_SESSION_HOURS=12
AUTH_SESSION_IDLE_MINUTES=120
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_REMEMBER_DAYS=30
AUTH_REMEMBER_IDLE_DAYS=7
AUTH_RESET_TOKEN_MINUTES=30
AUTH_VERIFY_TOKEN_HOURS=24
AUTH_MAX_REQUEST_BYTES=262144

# GitHub development Environment에서 DASHBOARD_DATA_NETWORK=elt_net을 설정한다.
# R2 endpoint/token/key는 Trino 서비스만 보유하고 dashboard에는 주입하지 않는다.
CHARTS_TRINO_URL=http://trino:8080
CHARTS_TRINO_USER=charts-studio
CHARTS_CACHE_TTL=600
CHARTS_MAX_CONCURRENT_QUERIES=4

# Ask Chat (선택 — 비우면 /chat 은 미설정 안내만 표시)
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-opus-4-8
CHAT_D1_ACCOUNT_ID=
CHAT_D1_DATABASE_ID=
CHAT_D1_API_TOKEN=

NOTIFICATION_INTERVAL_SECONDS=60
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_STALE_MINUTES=5
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_IDS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ALLOW_PLAINTEXT=false
