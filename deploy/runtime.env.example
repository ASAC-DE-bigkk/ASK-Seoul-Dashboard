# production 활성화 검토용 템플릿이다. 현재 main 배포는 비활성화되어 있으며 이 파일을
# 그대로 배포하지 않는다. main 활성화 때 TLS PostgreSQL topology와 Secret Manager를
# 확정한 뒤 GitHub Environment 변수 RUNTIME_ENV_FILE 경로에 mode 0600으로 렌더링한다.

# Compose/runtime
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_MEMORY_LIMIT=1g
DASHBOARD_CPUS=1.0
DASHBOARD_PIDS_LIMIT=256
UVICORN_WORKERS=1
HEALTHCHECK_HOST=dashboard.example.com

# Auth: 인터넷에 연결된 dev/main 서버는 모두 production 보안 검증을 사용한다.
AUTH_ENV=production
AUTH_MODE=required
AUTH_PUBLIC_BASE_URL=https://dashboard.example.com
AUTH_ALLOWED_HOSTS=dashboard.example.com
AUTH_COOKIE_SECURE=true
AUTH_TRUST_PROXY_HEADERS=false
AUTH_BIND_SESSION_USER_AGENT=true
AUTH_BIND_SESSION_IP=false
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=true
AUTH_SESSION_PEPPER=replace-with-at-least-32-random-characters
AUTH_MFA_MASTER_KEY=replace-with-another-32-character-random-secret
AUTH_AUTO_APPROVE_VERIFIED=false
AUTH_SESSION_HOURS=12
AUTH_SESSION_IDLE_MINUTES=120
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_REMEMBER_DAYS=30
AUTH_REMEMBER_IDLE_DAYS=7
AUTH_RESET_TOKEN_MINUTES=30
AUTH_VERIFY_TOKEN_HOURS=24
AUTH_MAX_REQUEST_BYTES=262144

# Production DB. CA 파일은 서버 deploy/certificates/ 아래에 두고 URL-encode가
# 필요한 사용자명/비밀번호 문자는 반드시 인코딩한다.
DATABASE_URL=postgresql+psycopg://ask_seoul:replace-me@db.example.com:5432/ask_seoul?sslmode=verify-full&sslrootcert=/run/certificates/db-ca.pem

# 같은 서버의 sample Compose를 사용할 때:
# GitHub Environment 변수 DASHBOARD_DATA_NETWORK=elt_net
# CHARTS_TRINO_URL=http://trino:8080
CHARTS_TRINO_URL=http://trino:8080
CHARTS_TRINO_USER=charts-studio
CHARTS_CACHE_TTL=600
CHARTS_MAX_CONCURRENT_QUERIES=4

# Notification worker
NOTIFICATION_INTERVAL_SECONDS=60
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_STALE_MINUTES=5
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_IDS=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ALLOW_PLAINTEXT=false
