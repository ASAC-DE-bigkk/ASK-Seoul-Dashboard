# Non-secret Compose validation template only.
# Real dev values live in GitHub development Environment secrets and are never committed or kept on server.
R2_DEV_DATA_CATALOG_URI=replace-with-existing-dev-catalog-uri
R2_DEV_DATA_CATALOG_WAREHOUSE=replace-with-existing-dev-warehouse
R2_DEV_DATA_CATALOG_TOKEN=replace-with-existing-dev-oauth-token
R2_DEV_ENDPOINT=replace-with-existing-r2-endpoint
R2_DEV_ACCESS_KEY_ID=replace-with-existing-r2-access-key
R2_DEV_SECRET_ACCESS_KEY=replace-with-existing-r2-secret-key

TRINO_CONFIG_REVISION=replace-with-config-sha256
TRINO_MEMORY_LIMIT=9g
TRINO_CPUS=4.0
TRINO_PIDS_LIMIT=1024
TRINO_TASK_CONCURRENCY=2
TRINO_QUERY_MAX_MEMORY_PER_NODE=2GB
TRINO_MEMORY_HEAP_HEADROOM_PER_NODE=2GB
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_TOTAL_MEMORY=4GB
